{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import-data": "sanity exec scripts/import-starter-data.ts --with-user-token",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@repo/sanity": "workspace:^",
    "@sanity/vision": "^6.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.18.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
